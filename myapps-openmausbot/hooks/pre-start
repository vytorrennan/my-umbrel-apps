#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
DATA_DIR="${APP_DATA_ROOT:-${APP_DIR}/data}"
mkdir -p "${DATA_DIR}/home"
# Earlier packages used upstream's 1001; the desktop's cua account uses 1000.
if [[ "$(stat -c %u "${DATA_DIR}/home")" == 1001 ]]; then
  find "${DATA_DIR}/home" -xdev -uid 1001 -exec chown -h 1000:1000 {} +
fi
chown 1000:1000 "${DATA_DIR}/home"
chmod 0644 "${APP_DIR}/Caddyfile" "${APP_DIR}/setup.mjs"
